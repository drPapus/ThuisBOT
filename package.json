{
  "name": "thuispoort-scanner-stage-3-2",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only adaptive polling scanner with new-listing detection for Thuispoort",
  "scripts": {
    "login": "tsx src/auth/login.ts",
    "capture": "tsx src/capture/reactionCapture.ts",
    "prepare-reaction": "tsx src/reaction/prepareReactionCli.ts",
    "react-once": "tsx src/reaction/reactOnceCli.ts",
    "replay-known": "tsx src/dev/replayKnownWoning.ts",
    "reaction-state": "tsx src/dev/reactionStateCli.ts",
    "verify-reaction": "tsx src/dev/verifyReactionCli.ts",
    "reaction-journal": "tsx src/dev/reactionJournalCli.ts",
    "scan": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:reaction-preparation": "tsx --test tests/reaction-preparation.test.ts",
    "test:react-once": "tsx --test tests/react-once.test.ts",
    "test:stage5": "tsx --test tests/stage5-*.test.ts",
    "test:stage2-local": "tsx --test tests/stage2-local.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.51.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
