# Public Thuispoort entry point used for manual login.
THUISPOORT_BASE_URL=https://www.thuispoort.nl

# The actual Thuispoort page that loads the Actueel aanbod results.
# This defaults to the URL below and can be overridden if the site changes.
THUISPOORT_AANBOD_PAGE_URL=https://www.thuispoort.nl/aanbod/te-huur

# Optional: an authenticated, read-only GET page/endpoint. Defaults to BASE_URL.
# Supplying one makes session-expiry detection more reliable.
# THUISPOORT_SESSION_CHECK_URL=https://www.thuispoort.nl/mijn-thuispoort
